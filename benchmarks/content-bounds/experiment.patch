+///|
+// Parents always precede children in the pool (not necessarily in DFS order).
+// Merge direct objects and finished children once, rather than scanning every
+// ancestor's complete subtree. Only the empty root uses its cell as a sentinel.
+fn finish_content_bounds(
+  nodes : Array[Node],
+  entries : Array[Entry],
+  order : Array[Int32],
+) -> Unit {
+  for index = nodes.length() - 1; index >= 0; index = index - 1 {
+    let n = nodes[index]
+    if n.subtree_count == 0 {
+      continue
+    }
+    let first = if n.count > 0 {
+      entries[order[n.start]].bounds
+    } else {
+      nodes[n.first_child].content_bounds
+    }
+    let mut min_x = first.min.x
+    let mut min_y = first.min.y
+    let mut min_z = first.min.z
+    let mut max_x = first.max.x
+    let mut max_y = first.max.y
+    let mut max_z = first.max.z
+    for i in 0..<(n.count + n.child_count) {
+      let b = if i < n.count {
+        entries[order[n.start + i]].bounds
+      } else {
+        nodes[n.first_child + i - n.count].content_bounds
+      }
+      if b.min.x < min_x {
+        min_x = b.min.x
+      }
+      if b.min.y < min_y {
+        min_y = b.min.y
+      }
+      if b.min.z < min_z {
+        min_z = b.min.z
+      }
+      if b.max.x > max_x {
+        max_x = b.max.x
+      }
+      if b.max.y > max_y {
+        max_y = b.max.y
+      }
+      if b.max.z > max_z {
+        max_z = b.max.z
+      }
+    }
+    // Select only validated finite endpoints; no arithmetic or rounding growth.
+    n.content_bounds = try! @geom.Aabb::new(
+      @geom.Vec3::new(min_x, min_y, min_z),
+      @geom.Vec3::new(max_x, max_y, max_z),
+    )
+  }
+}
