+///|
+test "content bounds are tight and content queries agree with independent scan" {
+  let root = @geom.Cube::new(@geom.Vec3::origin(), 128.0)
+  let entries = Array::makei(129, i => {
+    let x = (i * 19 % 180 - 90).to_double()
+    let y = (i * 37 % 180 - 90).to_double()
+    let z = (i * 53 % 180 - 90).to_double()
+    Entry::new(
+      i.reinterpret_as_uint(),
+      try! @geom.Aabb::new(
+        @geom.Vec3::new(x, y, z),
+        @geom.Vec3::new(x + 0.5, y + 0.5, z + 0.5),
+      ),
+    )
+  })
+  for budget in [1, 16, 4096] {
+    let tree = StaticObjectIndex::build(
+      entries,
+      root~,
+      max_objects=129,
+      max_nodes=budget,
+      split_threshold=1,
+    )
+    for n in tree.nodes {
+      let b = n.content_bounds
+      let mut endpoints = 0U
+      for i in n.start..<(n.start + n.subtree_count) {
+        let e = entries[tree.order[i]].bounds
+        if e.min.x == b.min.x {
+          endpoints = endpoints | 1U
+        }
+        if e.min.y == b.min.y {
+          endpoints = endpoints | 2U
+        }
+        if e.min.z == b.min.z {
+          endpoints = endpoints | 4U
+        }
+        if e.max.x == b.max.x {
+          endpoints = endpoints | 8U
+        }
+        if e.max.y == b.max.y {
+          endpoints = endpoints | 16U
+        }
+        if e.max.z == b.max.z {
+          endpoints = endpoints | 32U
+        }
+      }
+      assert_eq(endpoints, 63U)
+      let expected = scan_aabb(entries, b)
+      for capacity in [0, 1, expected.length(), expected.length() + 1] {
+        let output = FixedArray::make(capacity, 0U)
+        let r = tree.query_aabb_into(b, output, tree.workspace())
+        assert_eq(r.total_hits, expected.length())
+        for i in 0..<r.written {
+          assert_true(expected.contains(output[i]))
+        }
+      }
+    }
+  }
+}
