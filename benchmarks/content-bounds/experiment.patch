+///|
+test "tight content bounds preserve public cells and count a small whole cluster" {
+  let entries = Array::makei(40, i => {
+    @octree.Entry::new(
+      i.reinterpret_as_uint(),
+      bounds(31.0 + i.to_double() / 100.0, 32.0, 33.0, 0.0),
+    )
+  })
+  for budget in [1, 16, 4096] {
+    let tree = build(entries, max_nodes=budget, threshold=1)
+    assert_eq(tree.node_info(0).bounds, root().bounds)
+    for capacity in [0, 1, 39, 40, 41] {
+      let output = FixedArray::make(capacity + 2, 999U)
+      let result = tree.query_aabb_into(
+        bounds(31.0, 31.0, 31.0, 3.0),
+        output,
+        tree.workspace(),
+        offset=1,
+        capacity~,
+      )
+      assert_eq(result.total_hits, 40)
+      assert_eq(result.visited_nodes, 1)
+      assert_eq(result.tested_objects, 0)
+      assert_eq(result.written, if capacity < 40 { capacity } else { 40 })
+      assert_eq(
+        result.completeness,
+        if capacity < 40 {
+          @octree.Completeness::Truncated
+        } else {
+          @octree.Completeness::Complete
+        },
+      )
+      assert_eq(output[0], 999U)
+      assert_eq(output[capacity + 1], 999U)
+    }
+  }
+}
